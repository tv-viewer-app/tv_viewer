{
  "manifest_version": 3,
  "name": "TV Viewer - Free IPTV Streaming",
  "short_name": "TV Viewer",
  "version": "2.22.2",
  "description": "Browse and stream 21,000+ free, publicly available live TV and radio channels. Built-in HLS player with favorites, search, categories, and country filters. No account required.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "app.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "TV Viewer - IPTV Streaming"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://cdtxpefohpwtusmqengu.supabase.co/*"
  ]
}
